# API Configuration
# Add your API tokens here (comma-separated for multiple tokens)
API_TOKENS=scl-health-api-token-2024,your-custom-token-here

# Default API token (used if API_TOKENS is not set)
DEFAULT_API_TOKEN=scl-health-api-token-2024

# OpenAI API Key (required for document processing)
OPENAI_API_KEY=your-openai-api-key-here

# Google API Key (optional, for enhanced query generation)
GOOGLE_API_KEY=your-google-api-key-here

# Other API keys (optional, for web search functionality)
TAVILY_API_KEY=your-tavily-api-key-here
WEATHER_API_KEY=your-weather-api-key-here
TOGETHER_API_KEY=your-together-api-key-here